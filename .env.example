# Base URL of the FreshForward API (Railway service root). No trailing slash.
# Required in every environment - set it on Vercel for Production, Preview, AND Development.
VITE_API_URL=http://localhost:8000

# Optional: geocoding provider (defaults to Nominatim). Nominatim's public
# endpoint prohibits autocomplete use - switch to a keyed, Nominatim-compatible
# provider (e.g. LocationIQ) before any real marketing push. See NEEDED_FIXES.md D-23.
# VITE_GEOCODE_URL=https://us1.locationiq.com/v1
# VITE_GEOCODE_KEY=your-public-key

# NOTE: every VITE_* value is embedded in the client bundle and publicly
# readable. Never put a secret in one.
